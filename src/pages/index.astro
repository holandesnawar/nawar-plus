---
import Layout from '../layouts/Layout.astro'
import NavbarLanding from '../components/NavbarLanding'
import FooterNuevo from '../components/FooterNuevo.astro'
import '../styles/nawar-sections.css'

export const prerender = true

const verticales = [
  {
    icon: '📰',
    name: 'Nawar Noticias',
    tagline: 'Una noticia real, cada día.',
    desc: 'Cada día una noticia de los Países Bajos en neerlandés y español, con audio tipo podcast. Aprendes con lo que está pasando hoy mismo en el país donde vives.',
    free: '1 noticia a la semana en neerlandés y español por email',
    plus: 'Noticia diaria en neerlandés y español + audio tipo podcast',
  },
  {
    icon: '🎮',
    name: 'Nawar Juegos',
    tagline: 'Crea el hábito que nunca tuviste.',
    desc: 'Juegos ilimitados creados a partir de las noticias del día. Practicas el vocabulario nuevo y la gramática real que acabas de leer, sin sentir que estudias.',
    free: '1 juego básico al día',
    plus: 'Juegos ilimitados sobre cada noticia, con vocabulario y gramática real',
  },
  {
    icon: '🏫',
    name: 'Nawar Clases',
    tagline: 'Profesor experto en hispanohablantes.',
    desc: 'Una clase grupal en vivo cada semana con un profesor formado específicamente para hispanohablantes. Si el grupo supera 30 alumnos, se abre otro grupo. Y todas las clases anteriores quedan grabadas desde la primera.',
    free: 'Resumen texto de 1 clase por semana',
    plus: 'Clase grupal en vivo semanal + clases anteriores grabadas desde la primera',
  },
  {
    icon: '🤝',
    name: 'Nawar Comunidad',
    tagline: 'Tu gente hispana en Países Bajos.',
    desc: 'Comunidad privada de hispanohablantes en los Países Bajos. Resuelves dudas en español, compartes recursos con gente que entiende tu punto de partida y conoces a quien ya pasó por lo mismo que tú.',
    free: 'Acceso limitado al canal abierto',
    plus: 'Comunidad de hispanohablantes privada para tus dudas',
  },
]

const dolores = [
  'pagaste un curso de inburgering y aún no sabes pedir cita médica',
  'tu app te felicita por la racha de 240 días, pero el cartero te sigue mirando raro',
  'tienes amigos neerlandeses, pero todos te hablan en inglés para que "sea más fácil"',
  'llevas dos años aquí y la única frase que dices con seguridad es "ik spreek geen Nederlands"',
  'gastaste cientos de euros en clases particulares y solo aprendiste a presentarte',
]

const stats = [
  { num: '€800', label: 'el precio medio de un único nivel (A1, A2 o B1) en una academia de neerlandés en NL' },
  { num: '€65', label: 'el precio de una clase con un profesor de neerlandés' },
  { num: '83%', label: 'de hispanohablantes en NL abandonan el neerlandés durante el primer año' },
]
---

<Layout
  title="Nawar Plus | Aprender neerlandés sin que cueste un riñón"
  description="Nawar Plus, la suscripción que hace accesible el neerlandés para cualquier hispanohablante. Noticias diarias, juegos, clase semanal en vivo, comunidad y eventos. Cancelable cuando quieras."
  keywords="Nawar Plus, suscripción neerlandés, aprender holandés barato, clases neerlandés online, comunidad hispanohablantes Países Bajos"
>
  <NavbarLanding client:load />

  <!-- ════════════════════════════════════════════
       1. HERO — Logo + dolor (sin precios)
  ════════════════════════════════════════════ -->
  <section class="np-hero" data-navbar="dark">
    <div class="np-hero-aurora np-hero-aurora-1" aria-hidden="true"></div>
    <div class="np-hero-aurora np-hero-aurora-2" aria-hidden="true"></div>
    <div class="np-hero-aurora np-hero-aurora-3" aria-hidden="true"></div>
    <div class="np-hero-grid-bg" aria-hidden="true"></div>
    <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.45;"></div>
    <div class="np-hero-particles" aria-hidden="true">
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
      <span class="np-particle"></span>
    </div>
    <div class="np-hero-vignette" aria-hidden="true"></div>

    <div class="np-hero-inner">

      <!-- Logo central -->
      <div class="np-hero-logo-wrap np-anim" style="--hd:0.05s;">
        <img src="/nawar.plus.logo2.png" alt="Nawar Plus" class="np-hero-logo" />
      </div>

      <!-- Título estilo home: fade + azul bold -->
      <h1 class="np-hero-title np-anim" style="--hd:0.25s;">
        <span class="text-gradient-white">Aprender neerlandés</span><br>
        <span class="np-hero-title-blue">no debería sentirse así.</span>
      </h1>

      <!-- Subtítulo dolor -->
      <p class="np-hero-sub np-anim" style="--hd:0.40s;">
        Te mudaste, hiciste el esfuerzo, pagaste el curso, descargaste tres apps, miraste vídeos de YouTube y seguiste a una neerlandesa en Instagram. <strong>Y aún así, sigues sin entender al huisarts.</strong>
      </p>

      <!-- Scroll indicator chulo -->
      <a href="#dolor" class="np-scroll-down np-anim" style="--hd:0.55s;" aria-label="Sigue leyendo">
        <span class="np-scroll-down-label">Te entendemos</span>
        <span class="np-scroll-down-arrows" aria-hidden="true">
          <svg class="np-chevron np-chevron-1" width="28" height="18" viewBox="0 0 28 18" fill="none">
            <path d="M2 2l12 12 12-12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg class="np-chevron np-chevron-2" width="28" height="18" viewBox="0 0 28 18" fill="none">
            <path d="M2 2l12 12 12-12" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       2. CARTA — Sticky text reveal
  ════════════════════════════════════════════ -->
  <section id="dolor" class="np-letter" data-navbar="dark">
    <div class="np-letter-glow" aria-hidden="true"></div>

    <div class="np-letter-inner">
      <div class="np-letter-sticky">
        <span class="np-eyebrow-small">Esto va para ti</span>
        <h2 class="np-letter-heading">
          Sabemos que<br>
          <span style="color:#4da3ff;">esto te suena.</span>
        </h2>
        <p class="np-letter-aside">
          Es la misma historia que se repite en cada hispanohablante que llega aquí. No es culpa tuya. El problema es el método.
        </p>
      </div>

      <ul class="np-letter-list">
        {dolores.map((d, i) => (
          <li class="np-letter-item sr-bi">
            <span class="np-letter-num">{(i + 1).toString().padStart(2, '0')}</span>
            <p class="np-letter-text">{d}.</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       3. STATS — Números que duelen
  ════════════════════════════════════════════ -->
  <section class="np-stats" data-navbar="dark">
    <div class="np-stats-grid-bg" aria-hidden="true"></div>
    <div class="inner" style="position:relative;z-index:1;">
      <div class="np-stats-header sr">
        <span class="np-eyebrow-small">Los números que nadie te cuenta</span>
        <h2 class="np-stats-title">
          <span class="text-gradient-white">Aprender neerlandés no es caro.</span><br>
          <span style="color:#4da3ff;">El sistema sí lo es.</span>
        </h2>
      </div>

      <div class="np-stats-grid">
        {stats.map((s, i) => (
          <div class="np-stat-card sr-bi" style={`transition-delay:${i * 0.08}s;`}>
            <div class="np-stat-num">{s.num}</div>
            <div class="np-stat-line"></div>
            <p class="np-stat-label">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       4. EL GIRO — Aquí entra Nawar Plus
  ════════════════════════════════════════════ -->
  <section class="np-reveal section-light" data-navbar="light">
    <div class="inner" style="position:relative;z-index:1;">
      <div class="np-reveal-content sr">
        <span class="badge-light">Por eso existe Nawar Plus</span>
        <h2 class="np-reveal-title">
          Todo lo que necesitas para hablar neerlandés,<br>
          <span class="np-reveal-highlight">en un solo sitio.</span>
        </h2>
        <p class="np-reveal-sub">
          Nawar Plus es el plan completo: noticias diarias, juegos ilimitados, clase grupal en vivo cada semana con un profesor experto en hispanohablantes, todas las clases anteriores grabadas desde la primera, y una comunidad hispanohablante real en Países Bajos. Para que el neerlandés deje de ser una tarea pendiente y se convierta en parte de tu vida.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       5. LOS 4 VERTICALES
  ════════════════════════════════════════════ -->
  <section class="section-light" data-navbar="light" style="padding-bottom: 96px;">
    <div class="inner">
      <div class="np-vert-header sr">
        <h3 class="np-vert-section-title">Lo que recibirás</h3>
        <p class="np-vert-section-sub">Cuatro piezas que se complementan. Un único objetivo: que aprendas neerlandés de verdad.</p>
      </div>

      <div class="np-vert-grid">

        <!-- ── 1. Noticias ── -->
        <div class="np-vert-card sr-bi">
          <div class="np-vert-visual">
            <div class="np-vert-visual-glow" aria-hidden="true"></div>
            <div class="np-mock np-mock-news">
              <div class="np-mock-head">
                <span class="np-mock-tag">📰 NIEUWS · 12 MEI</span>
                <span class="np-mock-live"><span class="np-mock-live-dot"></span>Audio</span>
              </div>
              <div class="np-mock-news-nl">"Het kabinet kondigt nieuwe maatregelen aan…"</div>
              <div class="np-mock-news-es">El gobierno anuncia nuevas medidas…</div>
              <div class="np-mock-news-player">
                <span class="np-mock-play">
                  <svg width="10" height="12" viewBox="0 0 10 12" fill="currentColor"><path d="M0 0v12l10-6L0 0z"/></svg>
                </span>
                <div class="np-mock-wave">
                  <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
                <span class="np-mock-news-time">3:42</span>
              </div>
            </div>
          </div>
          <div class="np-vert-body">
            <h4 class="np-vert-name np-vert-name-logo">
              <img src="/nawar.noticias-2.png" alt="Nawar Noticias" />
            </h4>
            <p class="np-vert-tagline">Resumen de noticias semanales.</p>
            <p class="np-vert-desc">Cada día una noticia de los Países Bajos en neerlandés y español, con audio tipo podcast. Aprendes con lo que está pasando hoy mismo en el país donde vives.</p>
          </div>
        </div>

        <!-- ── 2. Juegos ── -->
        <div class="np-vert-card sr-bi" style="transition-delay:0.06s;">
          <div class="np-vert-visual">
            <div class="np-vert-visual-glow" aria-hidden="true"></div>
            <div class="np-mock np-mock-games">
              <div class="np-mock-head">
                <span class="np-mock-tag">🎮 WOORDLE · 3/6</span>
                <span class="np-mock-streak">🔥 12 días</span>
              </div>
              <div class="np-mock-grid">
                <span class="np-tile np-tile-miss">G</span><span class="np-tile np-tile-near">R</span><span class="np-tile np-tile-miss">O</span><span class="np-tile np-tile-hit">E</span><span class="np-tile np-tile-miss">N</span>
                <span class="np-tile np-tile-near">M</span><span class="np-tile np-tile-miss">O</span><span class="np-tile np-tile-hit">E</span><span class="np-tile np-tile-hit">D</span><span class="np-tile np-tile-miss">E</span>
                <span class="np-tile np-tile-hit">L</span><span class="np-tile np-tile-hit">I</span><span class="np-tile np-tile-hit">E</span><span class="np-tile np-tile-hit">V</span><span class="np-tile np-tile-hit">E</span>
              </div>
            </div>
          </div>
          <div class="np-vert-body">
            <h4 class="np-vert-name">Nawar Juegos</h4>
            <p class="np-vert-tagline">Un hobby sano que ayuda a tu aprendizaje.</p>
            <p class="np-vert-desc">Juegos ilimitados creados a partir de las noticias del día. Practicas el vocabulario nuevo y la gramática real que acabas de leer, sin sentir que estudias.</p>
          </div>
        </div>

        <!-- ── 3. Clases ── -->
        <div class="np-vert-card sr-bi" style="transition-delay:0.12s;">
          <div class="np-vert-visual">
            <div class="np-vert-visual-glow" aria-hidden="true"></div>
            <div class="np-mock np-mock-class">
              <div class="np-mock-head">
                <span class="np-mock-tag">🏫 CLASE EN VIVO</span>
                <span class="np-mock-live"><span class="np-mock-live-dot"></span>LIVE</span>
              </div>
              <div class="np-mock-avatars">
                <div class="np-avatar np-avatar-prof">MR</div>
                <div class="np-avatar">CR</div>
                <div class="np-avatar">LP</div>
                <div class="np-avatar">JM</div>
                <div class="np-avatar">AS</div>
                <div class="np-avatar np-avatar-more">+24</div>
              </div>
              <div class="np-mock-class-foot">
                <span class="np-mock-class-prof">Profe Marta</span>
                <span class="np-mock-class-info">Tema: verbos modales</span>
              </div>
            </div>
          </div>
          <div class="np-vert-body">
            <h4 class="np-vert-name">Nawar Clases</h4>
            <p class="np-vert-tagline">Profesor experto en hispanohablantes.</p>
            <p class="np-vert-desc">Una clase grupal en vivo cada semana con un profesor formado específicamente para hispanohablantes. Si el grupo supera 30 alumnos, se abre otro grupo. Y todas las clases anteriores quedan grabadas desde la primera.</p>
          </div>
        </div>

        <!-- ── 4. Comunidad ── -->
        <div class="np-vert-card sr-bi" style="transition-delay:0.18s;">
          <div class="np-vert-visual">
            <div class="np-vert-visual-glow" aria-hidden="true"></div>
            <div class="np-mock np-mock-chat">
              <div class="np-mock-head">
                <span class="np-mock-tag">🤝 #dudas-rápidas</span>
                <span class="np-mock-online"><span class="np-mock-live-dot"></span>614</span>
              </div>
              <div class="np-mock-msgs">
                <div class="np-mock-msg np-mock-msg-other">
                  <span class="np-mock-msg-name">Carlos · 🇲🇽</span>
                  <span class="np-mock-msg-body">¿Qué significa "gezellig"?</span>
                </div>
                <div class="np-mock-msg np-mock-msg-mine">
                  <span class="np-mock-msg-name">María · 🇨🇴</span>
                  <span class="np-mock-msg-body">¡Es como "acogedor"! No hay traducción exacta 😊</span>
                </div>
              </div>
            </div>
          </div>
          <div class="np-vert-body">
            <h4 class="np-vert-name">Nawar Comunidad</h4>
            <p class="np-vert-tagline">Tu gente hispana en Países Bajos.</p>
            <p class="np-vert-desc">Comunidad privada de hispanohablantes en los Países Bajos. Resuelves dudas en español, compartes recursos con gente que entiende tu punto de partida y conoces a quien ya pasó por lo mismo que tú.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       6. COMPARATIVA — Plan Gratuito vs Nawar Plus
  ════════════════════════════════════════════ -->
  <section id="planes" class="np-comp" data-navbar="dark">
    <div class="np-comp-glow" aria-hidden="true"></div>
    <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;"></div>

    <div class="inner" style="position:relative;z-index:1;">
      <div class="np-comp-header sr">
        <span class="np-eyebrow-small">Planes</span>
        <h2 class="np-comp-title">
          <span class="text-gradient-white np-comp-title-line">Empieza gratis.</span>
          <span class="np-comp-title-line" style="color:#4da3ff;font-weight:700;">Sube a Plus cuando quieras.</span>
        </h2>
        <p class="np-comp-sub">
          El plan gratuito sirve para crear hábito y demostrarte que el método funciona. Plus es para quien ya quiere aprender de verdad, con clase semanal en vivo, comunidad activa y una noticia diaria.
        </p>
      </div>

      <div class="np-comp-grid">

        <!-- Plan Gratuito -->
        <div class="np-comp-card np-comp-free sr-bi">
          <div class="np-comp-card-top">
            <span class="np-comp-tag">Plan Gratuito</span>
            <p class="np-comp-price">
              <span class="np-comp-amount">0€</span>
              <span class="np-comp-period">/siempre</span>
            </p>
            <p class="np-comp-desc">Crea el hábito. Demuestra el método. Sin método de pago.</p>
          </div>
          <ul class="np-comp-list">
            <li><span class="np-tick"></span><span>1 noticia semanal en neerlandés y español por email</span></li>
            <li><span class="np-tick"></span><span>1 juego básico al día</span></li>
            <li><span class="np-tick"></span><span>Reporte de la clase en neerlandés</span></li>
            <li><span class="np-tick"></span><span>Acceso al canal abierto de la comunidad</span></li>
            <li class="np-comp-locked"><span class="np-tick np-tick-off" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff6b6b" stroke-width="2.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></span><span>Sin clase en vivo y sin grabaciones</span></li>
          </ul>
          <a href="https://www.holandesnawar.com/lista-de-espera" class="np-comp-cta np-comp-cta-free">
            Empezar gratis
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>

        <!-- Nawar Plus -->
        <div class="np-comp-card np-comp-plus sr-bi" style="transition-delay:0.08s;">
          <div class="np-comp-card-glow" aria-hidden="true"></div>
          <span class="np-comp-ribbon">Recomendado</span>
          <div class="np-comp-card-top">
            <span class="np-comp-tag np-comp-tag-plus">Nawar Plus</span>
            <p class="np-comp-price">
              <span class="np-comp-amount" style="color:#fff;">30€</span>
              <span class="np-comp-period" style="color:rgba(255,255,255,0.6);">/mes</span>
            </p>
            <p class="np-comp-desc" style="color:rgba(255,255,255,0.85);">El plan completo. Por menos de un café al día.</p>
          </div>
          <ul class="np-comp-list">
            <li style="color:#fff;"><span class="np-tick np-tick-plus"></span><span><strong>Noticia diaria</strong> en neerlandés y español + audio tipo podcast</span></li>
            <li style="color:#fff;"><span class="np-tick np-tick-plus"></span><span><strong>Juegos ilimitados</strong> sobre las noticias con vocabulario nuevo y gramática real</span></li>
            <li style="color:#fff;"><span class="np-tick np-tick-plus"></span><span><strong>Clase grupal en vivo semanal</strong> con profesor experto en hispanohablantes</span></li>
            <li style="color:#fff;"><span class="np-tick np-tick-plus"></span><span><strong>Clases anteriores grabadas</strong> desde la primera</span></li>
            <li style="color:#fff;"><span class="np-tick np-tick-plus"></span><span><strong>Comunidad de hispanohablantes</strong> privada para tus dudas</span></li>
          </ul>
          <a href="https://www.holandesnawar.com/lista-de-espera" class="np-comp-cta np-comp-cta-plus">
            Apúntate a Plus · 30€/mes
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
          <p class="np-comp-cancel">Cancela cuando quieras · sin permanencia</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════
       7. LO MEJOR PARA HISPANOS
  ════════════════════════════════════════════ -->
  <section class="np-best" data-navbar="dark">
    <div class="np-best-glow" aria-hidden="true"></div>
    <div class="dots-dark" aria-hidden="true" style="position:absolute;inset:0;pointer-events:none;opacity:0.4;"></div>

    <div class="inner" style="position:relative;z-index:1;">
      <div class="np-best-header sr">
        <span class="np-eyebrow-small">Por qué Nawar Plus</span>
        <h2 class="np-best-title">
          <span class="text-gradient-white">Lo mejor para aprender</span><br>
          <span style="color:#4da3ff;">neerlandés siendo hispano.</span>
        </h2>
        <p class="np-best-sub">
          No competimos con academias en precio ni con apps en gamificación. Construimos otra cosa: el único plan diseñado por y para hispanohablantes que viven en Países Bajos. Lo que necesitas tú, no lo que necesita un angloparlante o un nativo europeo.
        </p>
      </div>

      <div class="np-best-pillars">
        <div class="np-best-pillar sr-bi">
          <div class="np-best-pillar-icon">🇪🇸</div>
          <h3 class="np-best-pillar-title">De español a neerlandés. Sin pasar por inglés.</h3>
          <p class="np-best-pillar-desc">Las explicaciones aprovechan que tu lengua materna es latina. Atajos gramaticales que solo funcionan si piensas en español. Cero confusión por traducir dos veces.</p>
        </div>
        <div class="np-best-pillar sr-bi" style="transition-delay:0.06s;">
          <div class="np-best-pillar-icon">👩‍🏫</div>
          <h3 class="np-best-pillar-title">Profesores que saben cómo aprendes.</h3>
          <p class="np-best-pillar-desc">Expertos en hispanohablantes. Conocen dónde tropezamos siempre, qué reglas se nos atragantan y cómo guiarnos sin frustración. No es un nativo improvisando, es alguien que enseñó a cientos como tú.</p>
        </div>
        <div class="np-best-pillar sr-bi" style="transition-delay:0.12s;">
          <div class="np-best-pillar-icon">🤝</div>
          <h3 class="np-best-pillar-title">Una tribu hispana en NL, no un foro frío.</h3>

}

.np-stats-grid {
  display: grid; grid-template-columns: 1fr; gap: 20px;
  max-width: 1024px; margin: 0 auto;
}
@media (min-width: 768px) { .np-stats-grid { grid-template-columns: repeat(3, 1fr); } }

.np-stat-card {
  padding: 36px 28px;
  border-radius: 22px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
  text-align: left;
  transition: border-color 0.35s, transform 0.35s cubic-bezier(0.22,1,0.36,1);
}
.np-stat-card:hover {
  border-color: rgba(77,163,255,0.35);
  transform: scale(1.02);
}
.np-stat-num {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(48px, 7vw, 82px);
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1;
  background: linear-gradient(160deg, #fff 0%, #4da3ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 18px;
}
.np-stat-line {
  width: 38px; height: 2px;
  background: #4da3ff;
  border-radius: 9999px;
  margin-bottom: 14px;
}
.np-stat-label {
  font-size: 14px;
  color: rgba(255,255,255,0.78);
  line-height: 1.55;
  margin: 0;
}

/* ════════════════════════════════════════════
   4. REVEAL — Aquí entra Nawar Plus
════════════════════════════════════════════ */
.np-reveal {
  padding: 110px 0 64px;
  background: #fff;
}
@media (max-width: 767px) {
  .np-reveal { padding: 72px 0 32px; }
}
.np-reveal-content {
  text-align: center;
  max-width: 880px;
  margin: 0 auto;
}
.np-reveal-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(30px, 4.5vw, 56px);
  font-weight: 600;
  letter-spacing: -0.025em;
  line-height: 1.1;
  color: #1D0084;
  margin: 8px 0 22px;
}
.np-reveal-highlight {
  position: relative;
  display: inline-block;
  color: #1D0084;
}
.np-reveal-highlight::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: 4px;
  height: 10px;
  background: rgba(77,163,255,0.30);
  border-radius: 4px;
  z-index: -1;
}
.np-reveal-sub {
  font-size: 17px;
  color: #1D0084;
  opacity: 0.85;
  line-height: 1.7;
  max-width: 680px;
  margin: 0 auto;
}

/* ════════════════════════════════════════════
   5. VERTICALES
════════════════════════════════════════════ */
.np-vert-header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 48px;
}
.np-vert-section-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(24px, 3vw, 36px);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #1D0084;
  margin: 0 0 12px;
}
.np-vert-section-sub {
  font-size: 16px;
  color: #1D0084;
  opacity: 0.75;
  line-height: 1.6;
  margin: 0;
}
.np-vert-grid {
  display: grid; grid-template-columns: 1fr; gap: 20px;
}
@media (min-width: 768px) { .np-vert-grid { grid-template-columns: 1fr 1fr; } }

.np-vert-card {
  position: relative; overflow: hidden;
  background: #fff;
  border: 1px solid #DDE6F5;
  border-radius: 22px;
  padding: 0;
  box-shadow: 0 2px 16px rgba(29,0,132,0.05);
  transition: transform 0.35s cubic-bezier(0.22,1,0.36,1), border-color 0.35s;
  display: flex; flex-direction: column; height: 100%;
}
.np-vert-card:hover {
  border-color: rgba(77,163,255,0.40);
}

/* ── Visual / mockup top area ── */
.np-vert-visual {
  position: relative;
  aspect-ratio: 16 / 10;
  background:
    radial-gradient(ellipse at top right, rgba(77,163,255,0.20) 0%, transparent 60%),
    linear-gradient(160deg, #1f0a8f 0%, #1D0084 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 1px solid rgba(77,163,255,0.18);
}
.np-vert-visual-glow {
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(77,163,255,0.18) 1px, transparent 1.5px);
  background-size: 16px 16px;
  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%);
  pointer-events: none;
}

.np-vert-body {
  padding: 24px 26px 26px;
  display: flex; flex-direction: column;
  flex: 1;
}

/* ════════════════════════════════════════════
   MOCKUPS — base
════════════════════════════════════════════ */
.np-mock {
  position: relative; z-index: 1;
  width: calc(100% - 36px);
  max-width: 320px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 12px;
  padding: 14px 14px 12px;
  display: flex; flex-direction: column;
  gap: 10px;
}
.np-mock-head {
  display: flex; align-items: center; justify-content: space-between;
  gap: 8px;
}
.np-mock-tag {
  font-size: 9px; font-weight: 700; letter-spacing: 0.10em;
  color: rgba(255,255,255,0.70);
  text-transform: uppercase;
}
.np-mock-live, .np-mock-online, .np-mock-streak {
  display: inline-flex; align-items: center; gap: 5px;
  font-size: 9px; font-weight: 700; letter-spacing: 0.06em;
  color: #10b981;
  background: rgba(16,185,129,0.14);
  padding: 3px 8px; border-radius: 9999px;
}
.np-mock-online { color: #4da3ff; background: rgba(77,163,255,0.14); }
.np-mock-streak {
  color: #fbbf24; background: rgba(251,191,36,0.10);
}
.np-mock-live-dot {
  width: 5px; height: 5px; border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 5px currentColor;
  animation: pulse-dot 1.5s ease-in-out infinite;
}

/* ── 1. NEWS mockup ── */
.np-mock-news-nl {
  font-size: 13px; font-weight: 600;
  color: #fff; line-height: 1.35;
}
.np-mock-news-es {
  font-size: 11px; color: #4da3ff;
  line-height: 1.4; font-weight: 500;
}
.np-mock-news-player {
  display: flex; align-items: center; gap: 9px;
  margin-top: 4px;
}
.np-mock-play {
  width: 22px; height: 22px; border-radius: 50%;
  background: #4da3ff; color: #1D0084;
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.np-mock-wave {
  flex: 1;
  display: flex; align-items: center; gap: 2px;
  height: 18px;
}
.np-mock-wave > span {
  width: 2px;
  border-radius: 1px;
  background: rgba(77,163,255,0.55);
}
.np-mock-wave > span:nth-child(1) { height: 30%; }
.np-mock-wave > span:nth-child(2) { height: 60%; }
.np-mock-wave > span:nth-child(3) { height: 90%; background: #4da3ff; }
.np-mock-wave > span:nth-child(4) { height: 50%; background: #4da3ff; }
.np-mock-wave > span:nth-child(5) { height: 75%; background: #4da3ff; }
.np-mock-wave > span:nth-child(6) { height: 40%; background: rgba(77,163,255,0.35); }
.np-mock-wave > span:nth-child(7) { height: 65%; }
.np-mock-wave > span:nth-child(8) { height: 25%; }
.np-mock-wave > span:nth-child(9) { height: 55%; }
.np-mock-wave > span:nth-child(10) { height: 70%; }
.np-mock-wave > span:nth-child(11) { height: 35%; }
.np-mock-wave > span:nth-child(12) { height: 50%; }
.np-mock-wave > span:nth-child(13) { height: 30%; }
.np-mock-wave > span:nth-child(14) { height: 20%; }
.np-mock-news-time {
  font-size: 10px; color: rgba(255,255,255,0.55);
  font-variant-numeric: tabular-nums;
}

/* ── 2. GAMES mockup (Wordle) ── */
.np-mock-grid {
  display: grid; grid-template-columns: repeat(5, 1fr);
  gap: 4px;
  margin-top: 2px;
}
.np-tile {
  aspect-ratio: 1;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 13px; font-weight: 800;
  color: #fff;
  border-radius: 4px;
}
.np-tile-miss { background: rgba(255,255,255,0.10); border: 1px solid rgba(255,255,255,0.14); color: rgba(255,255,255,0.55); }
.np-tile-near { background: #f59e0b; }
.np-tile-hit  { background: #10b981; }

/* ── 3. CLASS mockup ── */
.np-mock-avatars {
  display: grid; grid-template-columns: repeat(6, 1fr);
  gap: 5px;
}
.np-avatar {
  aspect-ratio: 1;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4da3ff 0%, #025dc7 100%);
  border: 1.5px solid rgba(255,255,255,0.20);
}
.np-avatar-prof {
  background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  border-color: rgba(251,191,36,0.50);
}
.np-avatar-more {
  background: rgba(255,255,255,0.08);
  border: 1.5px dashed rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.60);
  font-size: 9px;
}
.np-mock-class-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 2px;
}
.np-mock-class-prof {
  font-size: 10px; font-weight: 700; color: #fff;
}
.np-mock-class-info {
  font-size: 10px; color: rgba(255,255,255,0.55);
}

/* ── 4. CHAT mockup ── */
.np-mock-msgs {
  display: flex; flex-direction: column;
  gap: 6px;
}
.np-mock-msg {
  padding: 8px 10px;
  border-radius: 12px;
  font-size: 11px;
  line-height: 1.35;
  max-width: 90%;
}
.np-mock-msg-other {
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.92);
  align-self: flex-start;
  border-bottom-left-radius: 4px;
}
.np-mock-msg-mine {
  background: #1a6dd4;
  color: #fff;
  align-self: flex-end;
  border-bottom-right-radius: 4px;
}
.np-mock-msg-name {
  display: block;
  font-size: 9px; font-weight: 700;
  color: rgba(255,255,255,0.55);
  letter-spacing: 0.04em;
  margin-bottom: 3px;
}
.np-mock-msg-mine .np-mock-msg-name {
  color: rgba(255,255,255,0.75);
}
.np-mock-msg-body {
  display: block;
  font-weight: 500;
}

.np-vert-name {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 22px; font-weight: 700;
  color: #1D0084;
  letter-spacing: -0.015em;
  margin: 0 0 6px;
}
.np-vert-name-logo {
  display: block;
  margin: 0 0 4px;
  line-height: 0;
}
.np-vert-name-logo img {
  display: block;
  height: 44px;
  width: auto;
  max-width: 100%;
  object-fit: contain;
}
.np-vert-tagline {
  font-size: 14px; font-weight: 600;
  color: #1D0084;
  margin: 12px 0 4px;
}
.np-vert-desc {
  font-size: 15px; color: #1D0084; opacity: 0.85;
  font-weight: 500;
  line-height: 1.6;
  margin: 0 0 22px;
}
.np-vert-split {
  border-top: 1px solid #DDE6F5;
  padding-top: 18px;
  margin-top: auto;
  display: flex; flex-direction: column; gap: 12px;
}
.np-vert-split-row {
  display: grid;
  grid-template-columns: 64px 1fr;
  align-items: center;
  gap: 14px;
}
.np-vert-split-label {
  font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
  padding: 5px 0;
  border-radius: 9999px;
  text-align: center;
  line-height: 1;
}
.np-vert-split-free {
  background: #F0F5FF;
  color: #5A6480;
  border: 1px solid #DDE6F5;
}
.np-vert-split-plus {
  background: rgba(77,163,255,0.14);
  color: #025dc7;
  border: 1px solid rgba(77,163,255,0.30);
}
.np-vert-split-value {
  font-size: 13px;
  color: #1D0084;
  line-height: 1.45;
  font-weight: 500;
}

/* ════════════════════════════════════════════
   6. COMPARATIVA
════════════════════════════════════════════ */
.np-comp {
  background: #1D0084;
  padding: 100px 0;
  position: relative;
  overflow: hidden;
}
.np-comp-glow {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 900px; height: 600px; border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(77,163,255,0.20) 0%, transparent 65%);
  pointer-events: none;
}
.np-comp-header {
  text-align: center; max-width: 760px; margin: 0 auto 56px;
}
.np-comp-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(30px, 4.5vw, 56px);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.2;
  margin: 0 0 22px;
}
.np-comp-title-line {
  display: block;
  padding-bottom: 0.08em;
}
.np-comp-title-line + .np-comp-title-line {
  margin-top: 10px;
}
.np-comp-sub {
  font-size: 17px; color: rgba(255,255,255,0.82); line-height: 1.65;
  margin: 0;
}

.np-comp-grid {
  display: grid; grid-template-columns: 1fr; gap: 24px;
  max-width: 980px; margin: 0 auto;
  align-items: stretch;
}
@media (min-width: 900px) { .np-comp-grid { grid-template-columns: 1fr 1fr; } }

.np-comp-card {
  position: relative; overflow: hidden;
  border-radius: 24px;
  padding: 36px 32px;
  display: flex; flex-direction: column;
  height: 100%;
}
.np-comp-free {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.12);
}
.np-comp-plus {
  background: linear-gradient(160deg, rgba(11,109,240,0.20) 0%, rgba(77,163,255,0.08) 100%);
  border: 1.5px solid rgba(77,163,255,0.50);
}
.np-comp-card-glow {
  position: absolute; top: -120px; right: -120px;
  width: 380px; height: 380px; border-radius: 50%;
  background: radial-gradient(circle, rgba(77,163,255,0.32) 0%, transparent 65%);
  pointer-events: none;
}
.np-comp-ribbon {
  position: absolute; top: 18px; right: 22px;
  background: #4da3ff; color: #1D0084;
  font-size: 10px; font-weight: 700; letter-spacing: 0.12em;
  padding: 5px 12px; border-radius: 9999px;
  text-transform: uppercase;
  box-shadow: 0 4px 18px rgba(77,163,255,0.40);
  z-index: 2;
}

.np-comp-card-top { margin-bottom: 24px; position: relative; z-index: 1; }
.np-comp-tag {
  display: inline-block;
  font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
  text-transform: uppercase;
  padding: 0;
  margin-bottom: 14px;
  color: rgba(255,255,255,0.7);
  background: transparent;
  border: none;
}
.np-comp-tag-plus {
  color: #4da3ff;
  background: transparent;
  border: none;
}
.np-comp-price { display: flex; align-items: baseline; gap: 4px; margin-bottom: 8px; }
.np-comp-amount {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 56px; font-weight: 700; line-height: 1; letter-spacing: -0.025em;
  color: rgba(255,255,255,0.85);
}
.np-comp-period { font-size: 16px; color: rgba(255,255,255,0.5); font-weight: 500; }
.np-comp-desc { font-size: 14px; color: rgba(255,255,255,0.7); line-height: 1.55; margin: 0; }

/* ── Lista comp — checks MINIMALISTAS (sin bolita) ── */
.np-comp-list {
  list-style: none; padding: 0; margin: 0 0 28px;
  display: flex; flex-direction: column; gap: 14px;
  flex: 1;
  position: relative; z-index: 1;
}
.np-comp-list li {
  display: flex; align-items: flex-start; gap: 14px;
  font-size: 14.5px; color: rgba(255,255,255,0.88); line-height: 1.55;
  padding-bottom: 14px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.np-comp-list li > span:last-child { flex: 1; min-width: 0; }
.np-comp-list li:last-child { border-bottom: none; padding-bottom: 0; }
.np-tick {
  flex-shrink: 0;
  width: 18px; height: 18px;
  margin-top: 3px;
  position: relative;
}
.np-tick::after {
  content: '';
  position: absolute;
  left: 2px; top: 4px;
  width: 10px; height: 6px;
  border-left: 2px solid rgba(255,255,255,0.55);
  border-bottom: 2px solid rgba(255,255,255,0.55);
  transform: rotate(-45deg);
}
.np-tick-plus::after {
  border-color: #4da3ff;
  width: 11px; height: 6px;
}
.np-tick-off {
  opacity: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.np-tick-off::before,
.np-tick-off::after { content: none; display: none; }
.np-comp-locked { color: rgba(255,255,255,0.5) !important; }

.np-comp-cta {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 16px 24px; border-radius: 12px;
  font-size: 15px; font-weight: 700;
  text-decoration: none;
  width: 100%;
  transition: background 0.25s, transform 0.25s cubic-bezier(0.22,1,0.36,1), border-color 0.25s;
  position: relative; z-index: 1;
}
.np-comp-cta:hover { transform: scale(1.025); }
.np-comp-cta:active { transform: scale(0.98); }
.np-comp-cta-free {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.18);
  color: #fff;
}
.np-comp-cta-free:hover {
  background: rgba(255,255,255,0.14);
  border-color: rgba(255,255,255,0.30);
}
.np-comp-cta-plus {
  background: #4da3ff;
  color: #1D0084;
}
.np-comp-cta-plus:hover { background: #5eb4ff; }
.np-comp-cancel {
  text-align: center;
  font-size: 12px;
  color: rgba(255,255,255,0.5);
  margin-top: 14px;
  position: relative; z-index: 1;
}

/* ════════════════════════════════════════════
   7. BEST — Lo mejor para hispanos
════════════════════════════════════════════ */
.np-best {
  background: #1D0084;
  padding: 100px 0;
  position: relative;
  overflow: hidden;
}
.np-best-glow {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 900px; height: 700px; border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(77,163,255,0.20) 0%, transparent 65%);
  pointer-events: none;
}
.np-best-header {
  text-align: center; max-width: 820px; margin: 0 auto 64px;
}
.np-best-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(30px, 4.6vw, 56px);
  font-weight: 600;
  letter-spacing: -0.028em;
  line-height: 1.1;
  margin: 0 0 22px;
}
.np-best-sub {
  font-size: 17px;
  color: rgba(255,255,255,0.82);
  line-height: 1.65;
  margin: 0;
}

.np-best-pillars {
  display: grid; grid-template-columns: 1fr; gap: 20px;
  max-width: 1000px; margin: 0 auto;
}
@media (min-width: 768px) { .np-best-pillars { grid-template-columns: 1fr 1fr; } }

.np-best-pillar {
  position: relative;
  padding: 32px 30px 30px;
  border-radius: 22px;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.10);
}
.np-best-pillar-icon {
  display: inline-block;
  font-size: 48px;
  line-height: 1;
  margin-bottom: 16px;
  filter: drop-shadow(0 4px 14px rgba(77,163,255,0.22));
}
.np-best-pillar-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.015em;
  line-height: 1.25;
  color: #fff;
  margin: 0 0 10px;
}
.np-best-pillar-desc {
  font-size: 14.5px;
  color: rgba(255,255,255,0.78);
  line-height: 1.6;
  margin: 0;
}

/* ════════════════════════════════════════════
   8. FAQ — sin fondo, sobre brand purple
════════════════════════════════════════════ */
.np-faq {
  background: #1D0084;
  padding: 32px 0 110px;
  position: relative;
}
.np-faq-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 56px;
}
.np-faq-title {
  font-family: 'Poppins', system-ui, sans-serif;
  font-size: clamp(30px, 4.6vw, 56px);
  font-weight: 700;
  letter-spacing: -0.028em;
  line-height: 1.1;
  margin: 0;
}
.np-faq-list {
  max-width: 760px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
